---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('actualites');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'actualites'>;
}

const { post } = Astro.props;
const title = post.data.seoTitle ?? post.data.title;
const description = post.data.seoDescription ?? post.data.description;
---

<BaseLayout
  title={title}
  description={description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.date.toISOString()}
  section={post.data.category}
  author={site.officialName}
>
  <ArticleView
    entry={post}
    section="Gouvernement du Maniema"
    backHref="/actualites/"
    backLabel="Toutes les actualités"
    label={post.data.category}
  />
</BaseLayout>
