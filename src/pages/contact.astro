---
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact, site } from '../lib/content';
---

<BaseLayout
  title={contact.seo.title}
  description={contact.seo.description}
  image={contact.seo.ogImage}
>
  <PageIntro
    eyebrow={contact.intro.eyebrow}
    title={contact.intro.title}
    text={contact.intro.text}
    current="Contact"
  />

  <section class="container-page grid gap-10 py-12 lg:grid-cols-[1.15fr_0.85fr] lg:py-16">
    <div>
      <div class="rounded-xl border border-line bg-white p-6 sm:p-8">
        <div class="mb-6 border-b border-line pb-5">
          <h2 class="text-2xl">{contact.form.title}</h2>
          <p class="mt-1 text-sm text-muted">{contact.form.text}</p>
        </div>
        <ContactForm
          successMessage={contact.form.successMessage}
          errorMessage={contact.form.errorMessage}
          privacyNote={contact.form.privacyNote}
        />
      </div>
    </div>

    <aside class="space-y-5">
      <div class="rounded-xl border border-line bg-sage-100 p-6 sm:p-8">
        <h2 class="text-2xl">{contact.details.title}</h2>
        <p class="mt-3 text-sm leading-6 text-muted">{contact.details.text}</p>

        <ul class="mt-6 space-y-4 text-sm">
          <li class="flex gap-3">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-forest-500">
              <Icon name="map-pin" size={19} />
            </span>
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-forest-600">Adresse</p>
              <p class="mt-1 leading-6 text-muted">{site.address}</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-forest-500">
              <Icon name="mail" size={19} />
            </span>
            <div class="min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-forest-600">Email</p>
              <a class="mt-1 block break-all text-[13px] text-muted transition-colors hover:text-forest-800 sm:text-sm" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-forest-500">
              <Icon name="phone" size={19} />
            </span>
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-forest-600">Téléphone</p>
              <a class="mt-1 block text-muted transition-colors hover:text-forest-800" href={`tel:${site.phone.replace(/\s/g, '')}`}>
                {site.phone}
              </a>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-forest-500">
              <Icon name="clock" size={19} />
            </span>
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-forest-600">Horaires</p>
              <p class="mt-1 leading-6 text-muted">{site.hours}</p>
            </div>
          </li>
        </ul>

        <p class="mt-6 rounded-md border border-forest-100 bg-white/70 px-4 py-3 text-xs leading-5 text-muted">
          {contact.details.responseTime}
        </p>
      </div>

      <div class="rounded-xl border border-forest-100 bg-forest-50 p-6">
        <div class="flex gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-forest-500">
            <Icon name="file-text" size={19} />
          </span>
          <div>
            <h2 class="text-lg">Demandes officielles</h2>
            <p class="mt-2 text-sm leading-6 text-muted">{contact.details.notice}</p>
          </div>
        </div>
      </div>
    </aside>
  </section>
</BaseLayout>
