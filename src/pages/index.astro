---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ContactBanner from '../components/ContactBanner.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import Icon from '../components/Icon.astro';
import ReleaseList from '../components/ReleaseList.astro';
import { home, missions } from '../lib/content';

const actualites = (await getCollection('actualites')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const communiques = (await getCollection('communiques')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = actualites.find((post) => post.data.featured) ?? actualites[0];
---

<BaseLayout title={home.seo.title} description={home.seo.description} image={home.seo.ogImage}>
  <section class="relative overflow-hidden bg-sage-200">
    <div
      class="pointer-events-none absolute -right-36 -top-64 h-[730px] w-[730px] rounded-full border border-line"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-16 -top-44 h-[570px] w-[570px] rounded-full border border-line"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative grid items-center gap-10 py-14 md:grid-cols-2 lg:gap-16 lg:py-20">
      <div class="animate-rise">
        <p class="eyebrow mb-6 text-forest-600">{home.hero.eyebrow}</p>
        <h1 class="max-w-xl text-[44px] leading-[1.13] tracking-[-0.035em] lg:text-[60px]">
          {home.hero.titleLine1}<br />
          {home.hero.titleLine2} <span class="text-forest-400">{home.hero.titleHighlight}</span>
        </h1>
        <p class="mt-6 max-w-[460px] text-base leading-[1.85] text-muted">{home.hero.text}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={home.hero.primaryCta.href} variant="primary">
            {home.hero.primaryCta.label}
          </Button>
          <Button href={home.hero.secondaryCta.href} variant="outline">
            {home.hero.secondaryCta.label}
          </Button>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-3 text-xs text-muted">
          <span class="h-px w-7 bg-forest-200" aria-hidden="true"></span>
          {home.hero.values.map((value, index) => (
            <>
              {index > 0 && <span class="text-forest-200">·</span>}
              <span>{value}</span>
            </>
          ))}
        </div>
      </div>

      <div class="relative pb-5">
        <img
          src={home.hero.image}
          alt={home.hero.imageAlt}
          width="1200"
          height="960"
          class="h-[330px] w-full rounded-[10px] border border-line object-cover lg:h-[365px]"
          loading="eager"
          decoding="async"
        />
        <div class="absolute -bottom-1 left-5 right-5 flex items-center gap-4 rounded-lg border border-line bg-white px-5 py-4 shadow-[0_8px_30px_#25372d08] md:left-[-22px] md:right-12">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-forest-50 text-forest-500">
            <Icon name="shield" size={22} />
          </div>
          <div>
            <p class="text-sm font-semibold text-ink">{home.hero.cardTitle}</p>
            <p class="mt-1 text-xs leading-5 text-muted">{home.hero.cardText}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page pb-16 pt-16 lg:pt-20">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="eyebrow text-forest-600">{home.featured.eyebrow}</p>
        <h2 class="mt-3 text-4xl tracking-tight">{home.featured.title}</h2>
      </div>
      <a href={home.featured.linkHref} class="link-arrow">
        {home.featured.linkLabel}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1.8fr_1fr]">
      {featured && <FeaturedArticle post={featured} />}
      {communiques.length > 0 && (
        <ReleaseList
          releases={communiques}
          title={home.releases.title}
          linkLabel={home.releases.linkLabel}
          linkHref={home.releases.linkHref}
        />
      )}
    </div>
  </section>

  <section class="border-y border-line bg-sage-300">
    <div class="container-page grid gap-9 py-12 md:grid-cols-2 lg:grid-cols-4">
      {missions.items.map((mission) => (
        <a href="/missions/" class="group text-left focus-visible:ring-2">
          <Icon name={mission.icon} size={28} class="mb-4 text-forest-500" />
          <h3 class="text-2xl transition-colors group-hover:text-forest-700">{mission.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{mission.text}</p>
        </a>
      ))}
    </div>
  </section>

  <ContactBanner
    eyebrow={home.newsletter.eyebrow}
    title={home.newsletter.title}
    text={home.newsletter.text}
    buttonLabel={home.newsletter.buttonLabel}
    buttonHref={home.newsletter.buttonHref}
  />
</BaseLayout>
