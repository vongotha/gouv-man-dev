---
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  buttonLabel: string;
  buttonHref: string;
}

const { eyebrow, title, text, buttonLabel, buttonHref } = Astro.props;
---

<section class="container-page py-12 lg:py-16">
  <div class="flex flex-col justify-between gap-7 rounded-xl bg-forest-50 p-7 sm:p-8 md:flex-row md:items-center lg:p-10">
    <div>
      <p class="eyebrow mb-2 text-forest-600">{eyebrow}</p>
      <h2 class="max-w-2xl text-balance text-3xl leading-tight">{title}</h2>
      <p class="mt-3 max-w-xl text-sm leading-6 text-muted">{text}</p>
    </div>
    <Button href={buttonHref} variant="primary" class="shrink-0">
      {buttonLabel}
    </Button>
  </div>
</section>
