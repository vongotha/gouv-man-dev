---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { site } from '../lib/content';
import { navigation } from '../lib/nav';

const year = new Date().getFullYear();
const primaryNavigation = navigation.filter(
  (item) => item.label !== 'Actualités' && item.label !== 'Communiqués',
);
---

<footer class="bg-forest-900 text-[#e5eddf]">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.5fr_1fr_1fr] lg:py-14">
    <div>
      <a href="/" class="inline-flex focus-visible:ring-2" aria-label={`${site.name} — Accueil`}>
        <Brand light />
      </a>
      <p class="mt-5 max-w-sm text-sm leading-6 text-[#d2ddcb]">{site.footerNote}</p>
      <div class="mt-5 space-y-2 text-sm text-[#d2ddcb]">
        <a class="flex items-center gap-2 break-all transition-colors hover:text-white" href={`mailto:${site.email}`}>
          <Icon name="mail" size={16} />
          {site.email}
        </a>
        <a class="flex items-center gap-2 transition-colors hover:text-white" href={`tel:${site.phone.replace(/\s/g, '')}`}>
          <Icon name="phone" size={16} />
          {site.phone}
        </a>
      </div>
    </div>

    <div>
      <h2 class="mb-4 text-sm font-semibold text-white">Découvrir</h2>
      <nav aria-label="Navigation de pied de page" class="flex flex-col gap-1">
        {primaryNavigation.map((item) => (
          <a
            href={item.href}
            class="flex min-h-10 items-center text-sm text-[#d2ddcb] transition-colors hover:text-white hover:underline"
          >
            {item.label}
          </a>
        ))}
        <a href="/contact/" class="flex min-h-10 items-center text-sm text-[#d2ddcb] transition-colors hover:text-white hover:underline">Nous contacter</a>
      </nav>
    </div>

    <div>
      <h2 class="mb-4 text-sm font-semibold text-white">S'informer</h2>
      <div class="flex flex-col gap-1">
        <a href="/actualites/" class="flex min-h-10 items-center text-sm text-[#d2ddcb] transition-colors hover:text-white hover:underline">Actualités</a>
        <a href="/communiques/" class="flex min-h-10 items-center text-sm text-[#d2ddcb] transition-colors hover:text-white hover:underline">Communiqués</a>
      </div>
      <p class="mt-4 text-xs leading-5 text-[#d2ddcb]">
        {site.address}
        <br />
        {site.hours}
      </p>
      {site.socials.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-3">
          {site.socials.map((social) => (
            <a
              href={social.url}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#d2ddcb] transition-colors hover:text-white"
              target="_blank"
              rel="noreferrer"
            >
              {social.label}
              <Icon name="arrow-up-right" size={13} />
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="border-t border-[#4a614e]">
    <div class="container-page flex flex-wrap justify-between gap-4 py-6 text-xs text-[#d2ddcb]">
      <span>© {year} {site.name} — {site.country}</span>
      <span>{site.footerTagline}</span>
    </div>
  </div>
</footer>
