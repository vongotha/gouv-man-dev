---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  current: string;
  tone?: 'white' | 'sage';
}

const { eyebrow, title, text, current, tone = 'white' } = Astro.props;
---

<section class:list={['border-b border-line', tone === 'sage' ? 'bg-sage-100' : 'bg-white']}>
  <div class="container-page py-12 lg:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-8 flex items-center gap-2 text-xs text-muted">
      <a href="/" class="transition-colors hover:text-forest-800">Accueil</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink" aria-current="page">{current}</span>
    </nav>

    <p class="eyebrow mb-4 text-forest-600">{eyebrow}</p>
    <h1 class="max-w-4xl text-balance text-4xl leading-tight tracking-tight sm:text-5xl lg:text-[3.5rem]">
      {title}
    </h1>
    {text && <p class="mt-6 max-w-3xl text-base leading-8 text-muted sm:text-lg">{text}</p>}
    <slot />
  </div>
</section>
