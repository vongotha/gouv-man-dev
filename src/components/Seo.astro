---
import { site } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  section?: string;
  author?: string;
}

const {
  title,
  description,
  image = '/images/og-default.png',
  type = 'website',
  noindex = false,
  publishedTime,
  section,
  author = site.officialName,
} = Astro.props;
const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, base).toString();
const imageUrl = new URL(image, base).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  url: base.origin,
  logo: new URL(site.logo || '/images/emblem.svg', base).toString(),
  areaServed: 'Maniema, République démocratique du Congo',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kindu',
    addressRegion: 'Maniema',
    addressCountry: 'CD',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'service client',
    email: site.email,
    telephone: site.phone,
    availableLanguage: ['fr'],
  },
  sameAs: site.socials.map((social) => social.url),
};

const articleData =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'NewsArticle',
        headline: title,
        description,
        image: [imageUrl],
        datePublished: publishedTime,
        dateModified: publishedTime,
        articleSection: section,
        author: {
          '@type': 'Organization',
          name: author,
        },
        publisher: {
          '@type': 'GovernmentOrganization',
          name: site.officialName,
          logo: {
            '@type': 'ImageObject',
            url: new URL(site.logo || '/images/emblem.svg', base).toString(),
          },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonical,
        },
      }
    : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{section && <meta property="article:section" content={section} />}
{type === 'article' && <meta property="article:author" content={author} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
/>
{articleData && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleData).replace(/</g, '\\u003c')}
  />
)}
