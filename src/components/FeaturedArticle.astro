---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'actualites'>;
}

const { post } = Astro.props;
---

<a
  href={`/actualites/${post.id}/`}
  class="group grid overflow-hidden rounded-xl border border-line bg-white text-left transition-colors hover:border-forest-200 focus-visible:ring-2 md:grid-cols-[1.07fr_1fr]"
>
  <img
    src={post.data.image}
    alt={post.data.imageAlt}
    width="900"
    height="675"
    class="h-60 w-full object-cover md:h-full"
    loading="eager"
    decoding="async"
  />
  <div class="flex flex-col items-start p-6 sm:p-7">
    <span class="rounded bg-forest-50 px-2.5 py-1 text-xs font-medium text-forest-600">
      {post.data.category}
    </span>
    <p class="mt-4 text-xs text-muted">
      {formatDate(post.data.date)} <span class="px-1">·</span> {post.data.readingTime}
    </p>
    <h3 class="mt-3 font-serif text-[26px] leading-[1.3] transition-colors group-hover:text-forest-700">
      {post.data.title}
    </h3>
    <p class="mt-3 text-sm leading-6 text-muted">{post.data.description}</p>
    <span class="link-arrow mt-5">
      Lire l'article
      <Icon name="arrow-right" size={16} />
    </span>
  </div>
</a>
